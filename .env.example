# Copy this file to .env and fill values locally. Never commit real keys.

# Speech service credentials for ASR / TTS.
# Fill this with the Volcengine / Doubao speech API key.
VOLCENGINE_API_KEY=

# Thinking model credentials for operator-style report polishing and Agent replies.
# Speech API keys can work for ASR/TTS while still being rejected by Ark chat.
# Fill this with the Ark Chat Completions API key. Do not commit real keys.
ARK_API_KEY=
ARK_CHAT_COMPLETIONS_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_OPERATOR_POLISH_ENABLED=true
DOUBAO_OPERATOR_MODEL=doubao-seed-character-260628
DOUBAO_OPERATOR_MAX_TOKENS=900
# Optional compatibility switch if your VOLCENGINE_API_KEY is also an Ark chat key.
DOUBAO_OPERATOR_USE_SPEECH_API_KEY=false

# Legacy speech console credentials. Leave blank when VOLCENGINE_API_KEY is set.
VOLCENGINE_APP_KEY=
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_SECRET_KEY=

# Doubao TTS 2.0.
DOUBAO_TTS_ENABLED=true
DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional/sse
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_tianmeitaozi_uranus_bigtts
DOUBAO_TTS_FORMAT=wav
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_STREAMING_PLAYBACK_ENABLED=true

# BigASR streaming speech recognition.
DOUBAO_ASR_ENABLED=true
DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_MODEL=bigmodel
DOUBAO_ASR_CHUNK_MS=200
DOUBAO_ASR_STREAMING_ENABLED=true

# Optional ASR vocabulary boosting. Use the provider hotword table when you have one.
# DOUBAO_ASR_BOOSTING_TABLE_ID=
# DOUBAO_ASR_BOOSTING_TABLE_NAME=
# DOUBAO_ASR_HOTWORDS=键斗,Codex,HG113
